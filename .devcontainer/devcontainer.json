{
  "name": "Elixir & Postgres",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app", // Tells VS Code which service to enter
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    4000,
    5433,
    8025
  ],
  "portsAttributes": {
    "4000": {
      "label": "Phoenix Web Server",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8025": {
      "label": "Mailpit Dashboard",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "elixirLS.projectDir": "backend",
        "tailwindCSS.includeLanguages": {
          "elixir": "html",
          "phoenix-heex": "html"
        },
        "emmet.includeLanguages": {
          "phoenix-heex": "html"
        }
      },
      "extensions": [
        "JakeBecker.elixir-ls",
        "phoenixframework.phoenix",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "remoteUser": "vscode"
}