<div class="max-w-2xl mx-auto py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Your Rooms</h1>
    <div class="grid grid-cols-2 gap-2">
      <.link
        patch={~p"/rooms/new"}
        class="bg-black text-white px-4 py-2 rounded-lg hover:opacity-80"
      >
        + New Room
      </.link>
      <.link
        patch={~p"/rooms/join"}
        class="bg-black text-white px-4 py-2 rounded-lg hover:opacity-80"
      >
        + Join Room
      </.link>
    </div>
  </div>

  <div class="grid gap-4">
    <%= if(length(@rooms) > 0) do %>
      <%= for room <- @rooms do %>
        <.link
          navigate={~p"/rooms/#{room.invite_code}"}
          class="group p-4 border rounded-xl hover:bg-gray-50 dark:hover:bg-zinc-800 flex justify-between transition"
        >
          <div>
            <%!-- This will turn black (or white in dark mode) on hover --%>
            <p class="font-bold text-lg text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 transition">
              {room.name}
            </p>
            <%!-- This will darken from gray-500 to a more readable zinc-700 on hover --%>
            <p class="text-sm text-gray-500 italic group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition">
              Code: {room.invite_code}
            </p>
          </div>

          <div class="text-right">
            <span class={if room.is_public, do: "text-green-600", else: "text-blue-600"}>
              {if room.is_public, do: "Public", else: "Private"}
            </span>
          </div>
        </.link>
      <% end %>
    <% else %>
      <div class="flex justify text-center">
        <div>
          <%!-- This will turn black (or white in dark mode) on hover --%>
          <p class="font-bold text-lg text-white dark:text-zinc-100">
            There are no rooms available for you at the moment.
          </p>
          <%!-- This will darken from gray-500 to a more readable zinc-700 on hover --%>
          <p class="text-sm text-gray-500 italic group-hover:text-zinc-700">
            Go ahead and create one!
          </p>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%!-- The Modal for creating a new room --%>
<%!-- We check if the live_action is :new to show the modal --%>
<.modal
  :if={@live_action in [:new]}
  id="new-room-modal"
  show
  on_cancel={JS.patch(~p"/rooms")}
>
  <.header>
    New Room
    <:subtitle>Give your room a name to start collaborating.</:subtitle>
  </.header>

  <.simple_form for={@form} id="new-room-form" phx-change="validate" phx-submit="save">
    <.input
      field={@form[:name]}
      type="text"
      label="Room Name"
      placeholder="e.g. The Scribble Club"
    />
    <.input field={@form[:is_public]} type="checkbox" label="Make this room public?" />

    <:actions>
      <.button phx-disable-with="Creating...">Create Room</.button>
    </:actions>
  </.simple_form>
</.modal>

<%!-- The Modal for joining a room --%>
<%!-- We check if the live_action is :join to show the modal --%>
<.modal :if={@live_action == :join} id="join-modal" show on_cancel={JS.patch(~p"/rooms")}>
  <.header>
    Join a Room
    <:subtitle>Enter the 6-character invite code shared with you.</:subtitle>
  </.header>

  <%!-- We use a simple map for the form since we aren't backing this by a database record yet --%>
  <.simple_form for={%{}} phx-submit="join">
    <.input
      name="invite_code"
      value=""
      type="text"
      label="Invite Code"
      placeholder="e.g. ABCDEF"
      maxlength="6"
      class="uppercase w-full input"
      required
    />

    <:actions>
      <%!-- This now matches your "Create Room" button style exactly --%>
      <.button phx-disable-with="Joining...">
        Join Room
      </.button>
    </:actions>
  </.simple_form>
</.modal>
