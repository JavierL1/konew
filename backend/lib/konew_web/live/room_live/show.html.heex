<div class="max-w-5xl mx-auto py-10 px-4">
  <.header>
    <span class="text-zinc-900 dark:text-white">{@room.name}</span>
    <:subtitle>
      Share this code to invite others: <br />
      <span class="font-mono font-bold text-lg bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded text-zinc-900 dark:text-zinc-100">
        {@room.invite_code}
      </span>
    </:subtitle>

    <:actions>
      <.link
        navigate={~p"/rooms"}
        class="text-sm font-semibold leading-6 text-zinc-900 dark:text-zinc-300"
      >
        ← Back to all rooms
      </.link>
    </:actions>
  </.header>

  <div class="mt-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- Sidebar: Members List -->

    <KonewWeb.SocialComponents.member_list
      id="member-list"
      class="md:col-span-1"
      members={@room.members}
    />
    
<!-- Main Workspace Area: Takes up the remaining 3 columns -->
    <div class="md:col-span-3">
      <%= if @room.session do %>
        <!-- Active Session Template Frame -->
        <div class="flex mb-2">
          <.link
            patch={~p"/rooms/#{@room.invite_code}/draw"}
            class="bg-indigo-500 text-white px-4 py-2 rounded-lg hover:opacity-80"
          >
            ✏️ Draw something cool
          </.link>
        </div>
        <div class="p-6 bg-zinc-50 dark:bg-zinc-800/40 rounded-xl border border-zinc-200 dark:border-zinc-700">
          <div class="flex items-center gap-2 mb-4">
            <div class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" />
            <p class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
              <span class="font-bold text-zinc-900 dark:text-zinc-100">
                {@room.session.mechanic.name}
              </span>
            </p>
          </div>

          <div class="columns-1 gap-4 space-y-4">
            <%= for drawing <- @drawings do %>
              <div class="break-inside-avoid border-2 border-zinc-200 rounded-xl overflow-hidden bg-white shadow-sm hover:shadow-md transition-shadow">
                <img
                  src={"data:#{drawing.content_type};base64,#{drawing.image_data}"}
                  alt="User Snapshot Masterpiece"
                  class="w-full h-auto block rounded-lg border border-zinc-100 dark:border-zinc-800 bg-zinc-50 "
                />
                <div class="p-3 bg-zinc-50 flex justify-between items-center text-xs font-mono text-indigo-500">
                  <span class="px-2 py-1 bg-zinc-200 rounded-md uppercase">
                    {drawing.user.email}
                  </span>
                  <span class="px-2 py-1 bg-zinc-200 rounded-md uppercase">
                    {drawing.human_timestamp}
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <!-- Empty State Frame -->
        <div class="p-12 text-center bg-zinc-50 dark:bg-zinc-800/20 rounded-2xl border border-dashed border-zinc-200 dark:border-zinc-700">
          <p class="text-zinc-500 dark:text-zinc-400 mb-4">
            Please select a game mode to start playing!
          </p>
          <.link
            patch={~p"/rooms/#{@room.invite_code}/mechanics"}
            class="inline-block text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"
          >
            Select a game mode &rarr;
          </.link>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Selection Modal Overlay -->
<.modal
  :if={@live_action == :select_mechanic}
  id="mechanic-modal"
  show
  on_cancel={JS.patch(~p"/rooms/#{@room.invite_code}")}
>
  <.header>
    <span class="text-zinc-900 dark:text-white">Select a Game Mode</span>
    <:subtitle>
      The game mode cannot be overwritten once selected.
    </:subtitle>
  </.header>

  <div class="mt-6 space-y-3">
    <%= for mechanic <- @mechanics do %>
      <button
        phx-click="select-mechanic"
        phx-value-mechanic-id={mechanic.id}
        class="w-full text-left p-4 rounded-xl border border-zinc-200 dark:border-zinc-700 hover:border-zinc-900 dark:hover:border-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition flex justify-between items-center group cursor-pointer"
      >
        <div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
            {mechanic.name}
          </h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
            {mechanic.description}
          </p>
        </div>
        <.icon
          name="hero-chevron-right"
          class="w-5 h-5 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100"
        />
      </button>
    <% end %>
  </div>
</.modal>

<.modal
  :if={@live_action == :draw}
  id="drawing-workspace-modal"
  show
  on_cancel={JS.patch(~p"/rooms/#{@room.invite_code}")}
>
  <div class="p-2">
    <KonewWeb.WhiteboardComponents.whiteboard
      id="room-canvas-hook-root"
      hook="DrawCanvas"
      submit_label="Submit Masterpiece"
    />
  </div>
</.modal>
